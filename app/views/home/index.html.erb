                    <span class="material-symbols-outlined text-lg">account_tree</span>
                  </div>
                  <div class="text-left">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground"><%= t("home.demo.master_account") %></span>
                      <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-xs font-semibold text-success "><span class="h-1.5 w-1.5 rounded-full bg-success"></span> <%= t("home.demo.isolated_businesses", count: 3) %></span>
                      <span class="inline-flex items-center gap-1 rounded-full bg-warning/10 px-2 py-0.5 text-xs font-semibold text-warning "><%= t("home.demo.demo_label") %></span>
                    </div>
                    <p class="text-sm font-bold leading-tight text-foreground">Apex Multi-Venture Group Holdings</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="flex items-center gap-2 rounded-lg border border-line bg-card px-3 py-1.5 text-left shadow-sm ">
                    <span class="material-symbols-outlined text-xl text-primary">account_balance_wallet</span>
                    <div>
                      <p class="text-xs font-semibold uppercase leading-none text-muted-foreground"><%= t("home.demo.business_credit_balance") %></p>
                      <p class="text-sm font-bold leading-tight text-foreground"><span data-live="pool"><%= home_demo_number(9_420) %></span> <span class="text-xs font-normal text-muted-foreground"><%= t("home.demo.out_of", count: home_demo_number(10_000)) %></span></p>
                    </div>
                  </div>
                  <div class="inline-flex items-center gap-1.5 rounded-lg border border-success/30 bg-success/10 px-2.5 py-1.5 text-sm font-semibold text-success ">
                    <span class="material-symbols-outlined text-base text-success ">toll</span>
                    <span><%= t("home.demo.prepaid_credits") %></span>
                  </div>
                </div>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2 pt-0.5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="mr-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= t("home.demo.active_space") %></span>
                  <button
                    aria-pressed="true"
                    class="flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-bold text-muted-foreground transition-colors aria-pressed:bg-card aria-pressed:text-primary aria-pressed:shadow-sm hover:text-foreground cursor-pointer "
