               data-transactions-label="<%= t("home.demo.transactions") %>"
               data-cr-today-label="<%= t("home.demo.cr_today_label") %>"
               data-business-balance-label="<%= t("home.demo.business_balance_prefix") %>"
               data-remaining-label="<%= t("home.demo.remaining_label") %>">
