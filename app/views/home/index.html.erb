                    </div>
                    <div class="flex items-center justify-between gap-2.5 rounded-lg border border-line bg-card p-2.5 ">
                      <div class="flex min-w-0 items-center gap-2.5">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground "><span class="material-symbols-outlined text-base">print</span></span>
                        <div class="min-w-0">
                          <p class="truncate text-sm font-bold leading-tight text-foreground"><%= t("home.demo.receipt_printed") %></p>
                          <p class="truncate text-xs text-muted-foreground"><%= t("home.demo.browser_print") %></p>
