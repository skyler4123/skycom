          </div>
          <h1 class="max-w-5xl text-4xl font-black leading-tight tracking-tight text-foreground md:text-5xl "><%= t("home.hero.title_primary") %> <span class="mt-1 block text-primary"><%= t("home.hero.title_secondary") %></span></h1>
          <p class="mb-8 mt-4 max-w-3xl text-lg leading-relaxed text-muted-foreground"><%= t("home.hero.description_before") %><strong><%= t("home.hero.description_strong") %></strong><%= t("home.hero.description_after") %></p>
          <div class="flex w-full max-w-md flex-wrap items-center justify-center gap-3">
            <a
              class="inline-flex h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-primary px-6 text-base font-bold text-primary-foreground shadow-md transition-all hover:bg-primary/90 cursor-pointer sm:flex-none"
              href="/sign_up"
            >
              <span><%= t("home.hero.cta_primary") %></span>
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </a>
            <a class="inline-flex h-12 flex-1 items-center justify-center gap-2 rounded-lg bg-card px-6 text-base font-bold text-foreground shadow-sm transition-all hover:bg-muted sm:flex-none " href="#interactive-preview">
