<% content_for :title, t("home.meta.title") %>
<% content_for :head do %>
  <meta name="description" content="<%= t("home.meta.description") %>">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="<%= canonical_home_url %>">
  <% home_alternate_urls.each do |hreflang, href| %>
    <link rel="alternate" hreflang="<%= hreflang %>" href="<%= href %>">
  <% end %>
  <meta property="og:title" content="<%= t("home.meta.og_title") %>">
  <meta property="og:description" content="<%= t("home.meta.og_description") %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Skycom">
  <meta property="og:url" content="<%= canonical_home_url %>">
  <meta property="og:locale" content="<%= home_og_locale %>">
  <% home_og_alternate_locales.each do |locale| %>
    <meta property="og:locale:alternate" content="<%= locale %>">
  <% end %>
  <meta property="og:image" content="<%= "#{CANONICAL_BASE_URL}/icon.png" %>">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= t("home.meta.og_title") %>">
  <meta name="twitter:description" content="<%= t("home.meta.og_description") %>">
  <meta name="twitter:image" content="<%= "#{CANONICAL_BASE_URL}/icon.png" %>">
  <script type="application/ld+json">
    <%= raw home_structured_data_json %>
  </script>
<% end %>
<div class="bg-background ">
  <div class="relative flex min-h-screen w-full flex-col overflow-x-clip">
    <header class="sticky top-0 z-50 border-b border-line bg-background/85 backdrop-blur-xl ">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:px-8">
        <a
          class="flex items-center gap-2 cursor-pointer"
          href="<%= home_locale_path(I18n.locale) %>"
        >
          <img alt="<%= t("home.header.logo_alt") %>" class="h-8 w-auto object-contain" src="/icon.svg">
          <span class="text-lg font-bold tracking-tight text-foreground">Skycom</span>
        </a>
        <nav class="hidden items-center gap-6 lg:flex">
          <a class="text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground " href="#solutions"><%= t("home.header.solutions") %></a>
          <a class="text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground " href="#pricing"><%= t("home.header.pricing") %></a>
          <a class="text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground " href="#platform"><%= t("home.header.platform") %></a>
        </nav>
        <div class="flex items-center gap-1 rounded-lg border border-line bg-card p-0.5 text-xs font-bold"
             data-controller="home--language"
             role="group"
             aria-label="<%= t("home.language.label") %>">
          <% PUBLISHED_LOCALES.each do |locale| %>
            <a
              href="<%= home_locale_path(locale) %>"
              hreflang="<%= locale %>"
              lang="<%= locale %>"
              class="rounded-md px-2 py-1 transition-colors <%= I18n.locale == locale ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground" %>"
              aria-label="<%= t("home.language.switch_to", language: LANGUAGE_NAMES.fetch(locale)) %>"
              <%= 'aria-current="page"' if I18n.locale == locale %>
              data-action="click->home--language#sync"
              data-home--language-code-param="<%= locale %>"
            >
              <span class="hidden sm:inline"><%= LANGUAGE_NAMES.fetch(locale) %></span>
              <span class="sm:hidden"><%= locale.to_s.upcase %></span>
            </a>
          <% end %>
        </div>
        <div class="flex items-center gap-2" id="header-guest">
          <a
            class="inline-flex rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-all hover:bg-muted hover:text-foreground cursor-pointer "
            href="/sign_in"
            role="sign-in-button"
          >
            <%= t("home.header.sign_in") %>
          </a>
          <a
            class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-all hover:bg-primary/90 cursor-pointer"
            href="/sign_up"
            role="sign-up-button"
          >
            <%= t("home.header.claim_credits") %>
          </a>
        </div>
        <div class="hidden items-center gap-2" id="header-signedin">
          <a class="inline-flex rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-all hover:bg-muted hover:text-foreground cursor-pointer " href="/redirect/companies" id="header-dashboard-link"><%= t("home.header.dashboard") %></a>
          <a
            class="hidden rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-all hover:bg-muted hover:text-foreground cursor-pointer "
            href="/admin/companies"
            id="header-admin-link"
          >
            <%= t("home.header.admin_dashboard") %>
          </a>
          <a
            class="hidden rounded-lg px-4 py-2 text-sm font-semibold text-muted-foreground transition-all hover:bg-muted hover:text-foreground cursor-pointer "
            href="/companies/new"
            id="header-new-company-link"
          >
            <%= t("home.header.new_company") %>
          </a>
          <div class="flex items-center" data-controller="home--header--authentication"></div>
        </div>
      </div>
    </header>
    <main class="w-full">
      <!-- HERO SECTION -->
      <section class="relative overflow-hidden px-4 pb-16 pt-10 md:px-8 md:pt-16">
        <div class="pointer-events-none absolute -top-32 left-1/2 h-96 w-full max-w-4xl -translate-x-1/2 rounded-full bg-gradient-to-tr from-primary/20 via-background/60 to-success/20 blur-3xl "></div>
        <div class="relative mx-auto flex max-w-7xl flex-col items-center text-center">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-card px-4 py-1.5 shadow-sm ">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success/100 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-success"></span>
            </span>
            <span class="text-xs font-bold text-success "><%= t("home.hero.badge") %></span>
            <span class="text-muted-foreground/60">•</span>
            <a
