                    data-home--index-tenant-name-param="Apex Retail Flagship"
                    data-home--index-base-sales-param="18450"
                    data-home--index-base-txns-param="248"
                    data-home--index-base-credits-param="34.2"
                    data-tenant-tab="true"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-lg">storefront</span>
                    <span>Apex Retail Flagship POS</span>
                    <span class="rounded bg-primary px-1.5 py-0.5 text-xs font-bold text-primary-foreground"><%= t("home.demo.active_space_badge") %></span>
                  </button>
                  <button
                    aria-pressed="false"
                    class="flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-semibold text-muted-foreground transition-colors aria-pressed:bg-card aria-pressed:text-primary aria-pressed:shadow-sm hover:text-foreground cursor-pointer "
