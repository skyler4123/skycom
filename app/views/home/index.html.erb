                    data-home--index-tenant-name-param="Grand Azalea Hotel"
                    data-home--index-base-sales-param="9650"
                    data-home--index-base-txns-param="96"
                    data-home--index-base-credits-param="18.7"
                    data-tenant-tab="true"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-lg">hotel</span>
                    <span>Grand Azalea Hotel</span>
                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground "><%= t("home.demo.isolated") %></span>
                  </button>
                  <button
                    aria-pressed="false"
                    class="flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-semibold text-muted-foreground transition-colors aria-pressed:bg-card aria-pressed:text-primary aria-pressed:shadow-sm hover:text-foreground cursor-pointer "
                    data-action="click->home--index#switchTenant"
                    data-home--index-tenant-name-param="Bistro 88 Bar & Grill"
                    data-home--index-base-sales-param="5230"
                    data-home--index-base-txns-param="142"
                    data-home--index-base-credits-param="12.4"
                    data-tenant-tab="true"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-lg">restaurant</span>
                    <span>Bistro 88 Bar &amp; Grill</span>
                    <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground "><%= t("home.demo.isolated") %></span>
                  </button>
                </div>
                <a
                  class="flex items-center gap-1.5 rounded-lg border border-success/30 bg-card px-3 py-1.5 text-sm font-semibold text-success shadow-sm transition-colors hover:bg-success/90 hover:text-success-foreground cursor-pointer "
                  href="/sign_up"
                >
                  <span class="material-symbols-outlined text-base">add_business</span>
                  <span><%= t("home.demo.add_business") %></span>
                </a>
              </div>
            </div>
            <div class="grid grid-cols-1 gap-4 p-4 text-left md:grid-cols-3 md:p-6">
              <div class="rounded-xl border border-line bg-background p-4 transition-colors hover:border-line ">
                <div class="flex items-start justify-between">
                  <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground"><%= t("home.demo.today_gross_sales") %></span>
                    <p class="mt-1 text-2xl font-bold tracking-tight text-foreground" data-live="sales"><%= home_demo_money(18_450) %></p>
                  </div>
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary /50 ">
                    <span class="material-symbols-outlined text-xl">point_of_sale</span>
                  </div>
                </div>
                <div class="mt-2.5 flex items-center justify-between border-t border-line pt-2 text-xs text-muted-foreground ">
                  <span class="flex items-center gap-1 font-semibold text-success "><span class="material-symbols-outlined text-base">trending_up</span> <span data-live="txns"><%= home_demo_number(248) %> <%= t("home.demo.transactions") %></span></span>
                  <span><%= t("home.demo.across_registers", count: 3) %></span>
                </div>
              </div>
              <div class="rounded-xl border border-line bg-background p-4 transition-colors hover:border-line ">
                <div class="flex items-start justify-between">
