<% content_for :title, "Notifications" %>

<%= render "mobile/shared/header", title: "Notifications", avatar_name: (@employee ? @employee.name : current_user.name), avatar_path: (@employee ? mobile_company_employee_path(@company) : nil) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4" data-controller="mobile--notifications" data-mobile--notifications-company-id-value="<%= @company.id %>">
  <div class="flex flex-col gap-4">
    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <section class="flex flex-col gap-2 rounded-xl border border-line bg-card p-4 shadow-sm ">
          <div class="flex items-center justify-between gap-2">
            <h2 class="truncate text-sm font-bold text-foreground"><%= notification.name %></h2>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold <%= notification.severity_critical? ? "bg-danger/10 text-danger " : (notification.severity_warning? ? "bg-warning/10 text-warning " : "bg-primary/10 text-primary /40 ") %>">
              <%= notification.severity.humanize %>
            </span>
          </div>
          <p class="text-sm text-muted-foreground"><%= notification.description %></p>
          <span class="text-xs text-muted-foreground"><%= mobile_date(notification.created_at) rescue notification.created_at %></span>
        </section>
      <% end %>
    <% else %>
      <%= render "mobile/shared/empty_state", title: "No notifications", hint: "You have no notifications right now." %>
    <% end %>
  </div>
</main>