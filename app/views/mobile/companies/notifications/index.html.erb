<% content_for :title, "Notifications" %>

<%= render "mobile/shared/header", title: "Notifications", avatar_name: (@employee ? @employee.name : current_user.name), avatar_path: (@employee ? mobile_company_employee_path(@company) : nil) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <div class="flex flex-col gap-4">
    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <section class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between gap-2">
            <h2 class="truncate text-sm font-bold text-slate-900 dark:text-white"><%= notification.name %></h2>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold <%= notification.severity_critical? ? "bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300" : (notification.severity_warning? ? "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300" : "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300") %>">
              <%= notification.severity.humanize %>
            </span>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-300"><%= notification.description %></p>
          <span class="text-xs text-slate-400 dark:text-slate-500"><%= mobile_date(notification.created_at) rescue notification.created_at %></span>
        </section>
      <% end %>
    <% else %>
      <%= render "mobile/shared/empty_state", title: "No notifications", hint: "You have no notifications right now." %>
    <% end %>
  </div>
</main>