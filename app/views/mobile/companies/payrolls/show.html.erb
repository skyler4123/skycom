<% content_for :title, "Payroll" %>

<%= render "mobile/shared/header", title: "Payroll", avatar_name: @employee.name, avatar_path: mobile_company_employee_path(@company) %>

<main class="mx-auto w-full max-w-lg px-4 pb-8 pt-4">
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <span class="material-symbols-outlined text-xl text-blue-600 dark:text-blue-400">calendar_month</span>
      <select data-controller="mobile--select-nav" data-action="change->mobile--select-nav#navigate" aria-label="Pay period" class="w-full cursor-pointer appearance-none rounded-lg bg-white text-sm font-semibold text-slate-900 outline-none dark:bg-slate-900 dark:text-white">
        <% @month_options.each do |month| %>
          <option value="<%= mobile_company_payroll_path(@company, month: mobile_month_param(month)) %>" <%= "selected" if month == @month %>><%= mobile_month_label(month) %></option>
        <% end %>
      </select>
      <span class="material-symbols-outlined pointer-events-none text-xl text-slate-400 dark:text-slate-500">expand_more</span>
    </div>

    <% if @payroll %>
      <section class="flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 dark:border-amber-800 dark:bg-amber-900/20">
        <span class="material-symbols-outlined text-xl text-amber-700 dark:text-amber-400">info</span>
        <p class="text-xs font-medium text-amber-800 dark:text-amber-300">Preview layout — amounts marked <span class="font-bold">Sample</span> are placeholders; payroll money is not stored yet.</p>
      </section>

      <section class="relative overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="pointer-events-none absolute -right-8 -top-8 h-36 w-36 rounded-full bg-blue-50/80 dark:bg-blue-900/20"></div>
        <div class="relative flex items-start justify-between gap-2">
          <div class="flex min-w-0 items-center gap-3">
            <%= render "mobile/shared/avatar", name: @employee.name, size: "h-12 w-12 text-sm" %>
            <div class="min-w-0">
              <p class="truncate text-lg font-bold text-slate-900 dark:text-white"><%= @employee.name %></p>
              <p class="truncate text-xs text-slate-500 dark:text-slate-400"><%= [ @employee.branch&.name, @company.name ].compact.join(" • ") %></p>
            </div>
          </div>
          <%= mobile_payroll_status_badge(@payroll.status) %>
        </div>

        <div class="relative mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Estimated Net Earnings</span>
            <%= mobile_sample_badge %>
          </div>
          <p class="mt-1 text-4xl font-extrabold tracking-tight text-blue-600 dark:text-blue-400"><%= mobile_preview(:payroll_net) %></p>
          <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-base">event_repeat</span>
              Period: <%= mobile_date(@month.beginning_of_month) %> – <%= mobile_date(@month.end_of_month) %>
            </span>
            <span class="font-semibold text-slate-900 dark:text-white"><%= @month.end_of_month.day %> Days</span>
          </div>
        </div>

        <div class="relative mt-3">
          <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
            <span>Cycle Completion</span>
            <span class="font-semibold text-slate-900 dark:text-white">Step <%= @status_step %> of 3</span>
          </div>
          <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
            <div class="h-full rounded-full bg-blue-600 transition-all dark:bg-blue-500 <%= @progress_class %>"></div>
          </div>
        </div>
      </section>

      <div class="grid grid-cols-2 gap-2">
        <button type="button" disabled class="flex h-11 cursor-not-allowed items-center justify-center gap-1.5 rounded-lg bg-slate-100 px-3 text-xs font-semibold text-slate-400 dark:bg-slate-800 dark:text-slate-500">
          Draft Payslip
        </button>
        <%= link_to mobile_company_attendance_month_path(@company, month: mobile_month_param(@month)), class: "flex h-11 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-3 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600" do %>
          View Timesheet
        <% end %>
      </div>

      <section class="flex flex-col gap-2">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Compensation Breakdown</h2>
          <%= mobile_sample_badge %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <%= render "mobile/shared/stat_tile", label: "Gross Pay", value: mobile_preview(:payroll_gross), hint: "Base contract rate", icon: "payments", sample: true %>
          <%= render "mobile/shared/stat_tile", label: "Shifts", value: mobile_duration(@attendance_month&.total_work_minutes), hint: "#{@attendance_month&.total_present_days.to_i} present days", icon: "clinical_notes" %>
          <%= render "mobile/shared/stat_tile", label: "Overtime", value: mobile_preview(:payroll_overtime_amount), hint: "#{mobile_duration(@attendance_month&.total_overtime_minutes)} recorded", icon: "more_time", sample: true %>
          <%= render "mobile/shared/stat_tile", label: "Deductions", value: mobile_preview(:payroll_deductions), hint: "Tax & social health", icon: "receipt_long", sample: true %>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Line Items Summary</h2>
          <div class="flex items-center gap-1.5">
            <%= mobile_sample_badge %>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">Pre-approval</span>
          </div>
        </div>

        <div class="mt-3 flex flex-col divide-y divide-slate-100 dark:divide-slate-800">
          <div class="flex items-center justify-between gap-2 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><span class="material-symbols-outlined text-base">badge</span></span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">Monthly Base Salary</p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400">Base contract rate</p>
              </div>
            </div>
            <span class="shrink-0 text-sm font-bold text-slate-900 dark:text-white"><%= mobile_preview(:payroll_base_salary) %></span>
          </div>

          <div class="flex items-center justify-between gap-2 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><span class="material-symbols-outlined text-base">emergency</span></span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">Shift Allowance</p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400">Sample allowance</p>
              </div>
            </div>
            <span class="shrink-0 text-sm font-bold text-slate-900 dark:text-white"><%= mobile_preview(:payroll_allowance) %></span>
          </div>

          <div class="flex items-center justify-between gap-2 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><span class="material-symbols-outlined text-base">more_time</span></span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">Overtime</p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400"><%= mobile_duration(@attendance_month&.total_overtime_minutes) %> recorded</p>
              </div>
            </div>
            <span class="shrink-0 text-sm font-bold text-slate-900 dark:text-white"><%= mobile_preview(:payroll_overtime_amount) %></span>
          </div>

          <div class="flex items-center justify-between gap-2 py-2.5">
            <div class="flex min-w-0 items-center gap-2">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><span class="material-symbols-outlined text-base">shield</span></span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">Withholding Tax &amp; Social</p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400"><%= mobile_preview(:payroll_tax_label) %></p>
              </div>
            </div>
            <span class="shrink-0 text-sm font-bold text-red-600 dark:text-red-400"><%= mobile_preview(:payroll_tax) %></span>
          </div>
        </div>

        <div class="mt-3 flex items-center justify-between gap-2 rounded-xl bg-slate-100 p-3 dark:bg-slate-800">
          <div class="min-w-0">
            <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Total Payout (Net)</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Disbursement on <%= mobile_date(@month.end_of_month + 2.days) %></p>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="text-lg font-extrabold text-blue-600 dark:text-blue-400"><%= mobile_preview(:payroll_total) %></span>
            <%= mobile_sample_badge %>
          </div>
        </div>
      </section>

      <section class="flex items-start gap-2 rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <span class="material-symbols-outlined mt-0.5 text-xl text-blue-600 dark:text-blue-400">info</span>
        <div>
          <p class="text-sm font-semibold text-slate-900 dark:text-white">Payroll audit in progress</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">Hours and days come from your attendance records. Amounts marked Sample are placeholders until payroll money is implemented.</p>
        </div>
      </section>
    <% else %>
      <%= render "mobile/shared/empty_state", title: "No payroll data for this month.", hint: "Pick another pay period or ask an admin to generate payroll.", icon: "payments" %>
    <% end %>
  </div>
</main>
