<% content_for :title, "New Request" %>

<%= render "mobile/shared/header", title: "New Request", back_path: mobile_company_attendance_month_path(@company), avatar_name: @employee.name, avatar_path: mobile_company_employee_path(@company) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <div class="flex flex-col gap-4">
    <section class="flex items-center justify-between gap-2 rounded-xl border border-line bg-muted p-4 ">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary /40 ">
          <span class="material-symbols-outlined text-xl">event_repeat</span>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Attendance Request</p>
          <p class="truncate text-sm font-semibold text-foreground"><%= @employee.name %></p>
          <p class="truncate text-xs text-muted-foreground"><%= [ @employee.branch&.name, @employee.company&.name ].compact.join(" • ") %></p>
        </div>
      </div>
      <span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary /40 ">New</span>
    </section>

    <% if @attendance_request.errors.any? %>
      <section class="rounded-xl border border-danger/20 bg-danger/10 p-3 ">
        <p class="text-sm font-semibold text-danger ">Please fix the following:</p>
        <ul class="mt-1 list-inside list-disc text-xs text-danger ">
          <% @attendance_request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <%= form_with url: mobile_company_attendance_requests_path(@company), method: :post, class: "flex flex-col gap-4" do %>
      <section class="rounded-xl border border-line bg-card p-4 shadow-sm ">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-xl text-primary">edit_calendar</span>
          <h2 class="text-base font-semibold text-foreground">Request Details</h2>
        </div>

        <div class="mt-3 flex flex-col gap-3">
          <div class="flex flex-col gap-1.5">
            <%= label_tag "attendance_request[attendance_date]", "Date", class: "text-xs font-semibold text-foreground" %>
            <div class="relative flex items-center">
              <%= date_field_tag "attendance_request[attendance_date]", @attendance_request.attendance_date, required: true, class: "h-11 w-full rounded-lg border border-line bg-background px-3 pr-10 text-sm text-foreground outline-none transition-colors focus:border-primary/40 focus:bg-card " %>
              <span class="material-symbols-outlined pointer-events-none absolute right-3 text-xl text-muted-foreground">calendar_month</span>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <%= label_tag "attendance_request[business_type]", "Type", class: "text-xs font-semibold text-foreground" %>
            <div class="relative flex items-center">
              <%= select_tag "attendance_request[business_type]",
                    options_for_select(AttendanceRequest.business_types.keys.map { |type| [ mobile_business_type_label(type), type ] }, @attendance_request.business_type),
                    class: "h-11 w-full cursor-pointer appearance-none rounded-lg border border-line bg-background px-3 pr-10 text-sm text-foreground outline-none transition-colors focus:border-primary/40 focus:bg-card " %>
              <span class="material-symbols-outlined pointer-events-none absolute right-3 text-xl text-muted-foreground">keyboard_arrow_down</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
            <div class="flex min-w-0 flex-col gap-1.5">
              <%= label_tag "attendance_request[check_in_time]", "Check In", class: "truncate text-xs font-semibold text-foreground" %>
              <div class="relative flex items-center">
                <%= time_field_tag "attendance_request[check_in_time]", @attendance_request.check_in&.strftime("%H:%M"), required: true, class: "h-11 w-full rounded-lg border border-line bg-background px-3 pr-9 text-sm text-foreground outline-none transition-colors focus:border-primary/40 focus:bg-card " %>
                <span class="material-symbols-outlined pointer-events-none absolute right-2 text-lg text-muted-foreground">schedule</span>
              </div>
            </div>
            <div class="flex min-w-0 flex-col gap-1.5">
              <%= label_tag "attendance_request[check_out_time]", "Check Out", class: "truncate text-xs font-semibold text-foreground" %>
              <div class="relative flex items-center">
                <%= time_field_tag "attendance_request[check_out_time]", @attendance_request.check_out&.strftime("%H:%M"), class: "h-11 w-full rounded-lg border border-line bg-background px-3 pr-9 text-sm text-foreground outline-none transition-colors focus:border-primary/40 focus:bg-card " %>
                <span class="material-symbols-outlined pointer-events-none absolute right-2 text-lg text-muted-foreground">history_toggle_off</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="rounded-xl border border-line bg-card p-4 shadow-sm ">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-xl text-primary">description</span>
          <h2 class="text-base font-semibold text-foreground">Reason &amp; Justification</h2>
        </div>

        <div class="mt-3 flex flex-col gap-1.5" data-controller="mobile--character-counter">
          <div class="flex items-center justify-between gap-2">
            <%= label_tag "attendance_request[reason]", "Reason", class: "text-xs font-semibold text-foreground" %>
            <span data-mobile--character-counter-target="output" class="text-xs text-muted-foreground">0/240</span>
          </div>
          <%= text_area_tag "attendance_request[reason]",
                @attendance_request.reason,
                rows: 3,
                maxlength: 240,
                placeholder: "Why could you not check in onsite?",
                data: { mobile__character_counter_target: "input", action: "input->mobile--character-counter#update" },
                class: "w-full resize-none rounded-lg border border-line bg-background p-3 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary/40 focus:bg-card " %>
        </div>

        <div class="mt-3 flex items-center justify-between gap-2 rounded-lg border border-dashed border-line bg-background p-3 ">
          <div class="flex min-w-0 items-center gap-2">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground ">
              <span class="material-symbols-outlined text-xl">cloud_upload</span>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-muted-foreground">Attach photo or proof</p>
              <p class="text-xs text-muted-foreground">Not available in the mobile app yet</p>
            </div>
          </div>
          <span class="material-symbols-outlined shrink-0 text-xl text-muted-foreground/60">block</span>
        </div>
      </section>

      <section class="flex items-center justify-between gap-2 rounded-xl border border-line bg-background p-4 ">
        <div class="flex min-w-0 items-center gap-2">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary /40 ">
            <%= mobile_preview(:approver_initials) %>
          </span>
          <div class="min-w-0">
            <p class="text-xs text-muted-foreground">Assigned Approver</p>
            <p class="truncate text-sm font-semibold text-foreground"><%= mobile_preview(:approver_name) %></p>
          </div>
        </div>
        <%= mobile_sample_badge %>
      </section>

      <div class="flex flex-col gap-2 pt-1">
        <button type="submit" class="flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-primary text-sm font-bold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 active:scale-95 ">
          Submit Request
        </button>
        <%= link_to "Cancel", mobile_company_attendance_month_path(@company), class: "flex h-11 w-full cursor-pointer items-center justify-center rounded-lg text-sm font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground " %>
      </div>
    <% end %>
  </div>
</main>
