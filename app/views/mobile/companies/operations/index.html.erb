<% content_for :title, "Operations" %>

<%= render "mobile/shared/header", title: "Operations", avatar_name: @employee.name, avatar_path: mobile_company_employee_path(@company) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <div class="flex flex-col gap-4">
    <section class="flex items-center justify-between gap-3 rounded-xl border border-line bg-card p-4 shadow-sm">
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <span class="material-symbols-outlined text-xl">apps</span>
        </span>
        <div class="min-w-0">
          <p class="truncate text-sm font-bold text-foreground"><%= @company.name %></p>
          <p class="text-xs text-muted-foreground">Operations for this company</p>
        </div>
      </div>
      <span class="shrink-0 rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">
        <%= pluralize(@appointments.size, "operation") %>
      </span>
    </section>

    <% if @appointments.any? %>
      <% @appointments.each do |appointment| %>
        <% operation = appointment.operation %>
        <% location = appointment.is_a?(BranchOperationAppointment) ? appointment.branch : appointment.warehouse %>
        <section class="rounded-xl border border-line bg-card p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground">
                <span class="material-symbols-outlined text-xl">storefront</span>
              </span>
              <div class="min-w-0">
                <h2 class="truncate text-sm font-bold text-foreground"><%= operation.name.presence || "Untitled operation" %></h2>
                <p class="truncate text-xs text-muted-foreground"><%= [ operation.code, location&.name ].compact.join(" • ") %></p>
              </div>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary"><%= appointment.workflow_status.humanize %></span>
              <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground"><%= operation.workflow_status.humanize %></span>
            </div>
          </div>

          <div class="mt-3 grid grid-cols-2 gap-2">
            <div class="rounded-lg border border-line bg-background p-2.5">
              <p class="text-xs text-muted-foreground">Type</p>
              <p class="mt-0.5 text-sm font-semibold text-foreground"><%= operation.operation_type.upcase %></p>
            </div>
            <div class="rounded-lg border border-line bg-background p-2.5">
              <p class="text-xs text-muted-foreground">Location</p>
              <p class="mt-0.5 text-sm font-semibold text-foreground"><%= location&.name || "—" %></p>
            </div>
            <div class="col-span-2 rounded-lg border border-line bg-background p-2.5">
              <p class="text-xs text-muted-foreground">Resolution</p>
              <p class="mt-0.5 text-sm font-semibold text-foreground"><%= operation.resolution.humanize %></p>
            </div>
          </div>

          <% if appointment.is_a?(BranchOperationAppointment) && %w[pos reception].include?(operation.operation_type) %>
            <% if operation.operation_type == "pos" %>
              <%= link_to mobile_company_pos_path(@company, operation, branch_id: appointment.branch_id),
                class: "mt-3 flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-primary text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 active:scale-95" do %>
                <span class="material-symbols-outlined text-xl">point_of_sale</span>
                Open POS
              <% end %>
            <% else %>
              <%= link_to mobile_company_reception_path(@company, operation, branch_id: appointment.branch_id),
                class: "mt-3 flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-primary text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 active:scale-95" do %>
                <span class="material-symbols-outlined text-xl">concierge</span>
                Open Reception
              <% end %>
            <% end %>
          <% end %>
        </section>
      <% end %>
    <% else %>
      <%= render "mobile/shared/empty_state", title: "No operations yet", hint: "Add a branch or warehouse to start using operations.", icon: "apps" %>
    <% end %>
  </div>
</main>
