<% content_for :title, @page.name %>

<%= render "mobile/shared/header",
  title: @page.name,
  back_path: mobile_company_operations_path(@company),
  avatar_name: @employee.name,
  avatar_path: mobile_company_employee_path(@company) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <div class="flex flex-col gap-4">
    <section class="rounded-xl border border-line bg-card p-6 text-center shadow-sm">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary">
        <span class="material-symbols-outlined text-3xl">construction</span>
      </div>

      <% if @page.placeholder? %>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-primary">Coming soon</p>
        <h1 class="mt-2 text-xl font-black text-foreground"><%= @page.name %></h1>
        <p class="mt-2 text-sm text-muted-foreground">We are building this page. It will be available here soon.</p>
      <% else %>
        <p class="mt-5 text-xs font-bold uppercase tracking-wider text-success">Ready</p>
        <h1 class="mt-2 text-xl font-black text-foreground"><%= @page.name %></h1>
        <p class="mt-2 text-sm text-muted-foreground">This page is ready to use on mobile.</p>
      <% end %>
    </section>

    <section class="grid grid-cols-2 gap-2">
      <div class="rounded-xl border border-line bg-card p-3 shadow-sm">
        <p class="text-xs text-muted-foreground">Branch</p>
        <p class="mt-1 truncate text-sm font-semibold text-foreground"><%= @page.branch.name %></p>
      </div>
      <div class="rounded-xl border border-line bg-card p-3 shadow-sm">
        <p class="text-xs text-muted-foreground">Role</p>
        <p class="mt-1 truncate text-sm font-semibold text-foreground"><%= @page.target_role.humanize %></p>
      </div>
      <div class="rounded-xl border border-line bg-card p-3 shadow-sm">
        <p class="text-xs text-muted-foreground">Target screen</p>
        <p class="mt-1 truncate text-sm font-semibold text-foreground"><%= @page.target_resolution.humanize %></p>
      </div>
      <div class="rounded-xl border border-line bg-card p-3 shadow-sm">
        <p class="text-xs text-muted-foreground">Status</p>
        <p class="mt-1 truncate text-sm font-semibold text-foreground"><%= @page.workflow_status.humanize %></p>
      </div>
    </section>

    <%= link_to mobile_company_operations_path(@company),
      class: "inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-card px-4 py-3 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-muted" do %>
      <span class="material-symbols-outlined text-[20px]">arrow_back</span>
      Back to Operations
    <% end %>
  </div>
</main>
