<% content_for :title, "Home" %>

<%= render "mobile/shared/header", title: "Home", avatar_name: (@employee ? @employee.name : current_user.name), avatar_path: (@employee ? mobile_company_employee_path(@company) : nil) %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <% if @employee %>
    <div class="flex flex-col gap-4">
      <section class="flex items-center gap-3 rounded-xl border border-line bg-card p-4 shadow-sm ">
        <%= render "mobile/shared/avatar", name: @employee.name, size: "h-12 w-12 text-sm" %>
        <div class="min-w-0">
          <p class="truncate text-lg font-bold text-foreground"><%= mobile_greeting(@employee.name) %></p>
          <div class="mt-1 flex flex-wrap items-center gap-1.5">
            <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary /40 ">
              <span class="material-symbols-outlined text-sm">business</span>
              <span class="max-w-44 truncate"><%= @company.name %></span>
            </span>
            <% if @employee.code.present? %>
              <span class="text-xs font-medium text-muted-foreground">#<%= @employee.code %></span>
            <% end %>
          </div>
        </div>
      </section>

      <section class="relative overflow-hidden rounded-xl border border-line bg-card p-4 shadow-sm ">
        <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-primary/10 "></div>
        <div class="relative flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full <%= @checked_in ? "bg-success/100" : "bg-danger/100" %>"></span>
              <span data-check-in-status="<%= @checked_in ? "checked_in" : "not_checked_in" %>" class="text-xs font-semibold uppercase tracking-wider <%= @checked_in ? "text-success " : "text-muted-foreground" %>"><%= @checked_in ? "Checked In" : "Not Checked In" %></span>
            </div>
            <div class="mt-1 flex items-baseline gap-2" data-controller="mobile--clock">
              <span data-mobile--clock-target="time" class="text-3xl font-bold tracking-tight text-foreground">--:--:--</span>
              <span data-mobile--clock-target="period" class="text-sm font-semibold uppercase text-muted-foreground">--</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
              <% if @today_shift %>
                Scheduled: <%= mobile_time(@today_shift.expected_start_at) %> – <%= mobile_time(@today_shift.expected_end_at) %>
              <% else %>
                No shift scheduled today
              <% end %>
            </p>
          </div>
          <div class="flex max-w-44 flex-col items-end gap-1 text-right">
            <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary /40 ">
              <span class="material-symbols-outlined text-base">location_on</span>
              <span class="truncate"><%= @employee.branch&.name || "Branch check-in" %></span>
            </span>
            <span class="truncate text-xs text-muted-foreground"><%= @company.name %></span>
          </div>
        </div>

        <div class="relative mt-4">
          <%= button_to mobile_company_attendances_path(@company), method: :post, class: "flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-primary text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 active:scale-95 " do %>
            <span class="material-symbols-outlined text-xl">login</span>
            <%= @checked_in ? "Check In Again" : "Clock In" %>
          <% end %>

          <% if @check_in_logs.any? %>
            <div class="mt-3 rounded-lg border border-line bg-muted/50 p-3 ">
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Today's Check-ins</p>
                <span class="rounded-full border border-line bg-card px-2 py-0.5 text-xs font-bold text-foreground "><%= @check_in_logs.size %></span>
              </div>
              <div class="mt-2 flex flex-wrap gap-1.5">
                <% @check_in_logs.each do |log| %>
                  <span data-check-in-time class="inline-flex items-center gap-1 rounded-full border border-line bg-card px-2.5 py-1 text-xs font-semibold text-foreground ">
                    <span class="material-symbols-outlined text-sm text-success">login</span>
                    <%= mobile_time(log.logged_at, utc_offset: @company_utc_offset) %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section class="grid grid-cols-3 gap-2 md:gap-4">
        <%= render "mobile/shared/stat_tile", label: "Attendance", value: mobile_attendance_rate(@attendance_month), hint: "This month", icon: "task_alt" %>
        <div class="flex flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm ">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-medium text-muted-foreground">Paid Leave</span>
            <span class="material-symbols-outlined text-xl text-primary">beach_access</span>
          </div>
          <div class="mt-2">
            <p class="text-lg font-bold leading-tight text-foreground"><%= @attendance_balance.remaining_days.to_i %> Days</p>
            <p class="mt-0.5 text-xs text-muted-foreground"><%= @attendance_balance.pending_days.to_i %> Pending</p>
          </div>
        </div>
        <%= render "mobile/shared/stat_tile", label: "Overtime", value: mobile_duration(@attendance_month&.total_overtime_minutes), hint: "This month", icon: "schedule" %>
      </section>

      <section class="flex flex-col gap-2">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-sm font-bold text-foreground">Quick Operations</h2>
          <span class="text-xs font-semibold text-primary">Skycom ERP</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          <%= link_to mobile_company_employee_path(@company), class: "group flex cursor-pointer flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm transition-colors hover:border-primary/30 " do %>
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary /40 ">
                <span class="material-symbols-outlined text-2xl">badge</span>
              </div>
              <span class="material-symbols-outlined text-lg text-muted-foreground/60 transition-transform group-hover:translate-x-0.5 ">arrow_forward</span>
            </div>
            <div class="mt-3">
              <p class="text-sm font-bold text-foreground">Employee Info</p>
              <p class="mt-0.5 text-xs text-muted-foreground">Profile, branch, roles</p>
            </div>
          <% end %>

          <%= link_to mobile_company_attendance_month_path(@company), class: "group flex cursor-pointer flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm transition-colors hover:border-primary/30 " do %>
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary /40 ">
                <span class="material-symbols-outlined text-2xl">calendar_month</span>
              </div>
              <% if @attendance_month&.total_records.to_i.positive? %>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-bold text-primary /40 "><%= @attendance_month.total_present_days %>/<%= @attendance_month.total_records %></span>
              <% else %>
                <span class="material-symbols-outlined text-lg text-muted-foreground/60">arrow_forward</span>
              <% end %>
            </div>
            <div class="mt-3">
              <p class="text-sm font-bold text-foreground">Attendance</p>
              <p class="mt-0.5 text-xs text-muted-foreground">Monthly log &amp; requests</p>
            </div>
          <% end %>

          <%= link_to mobile_company_payroll_path(@company), class: "group flex cursor-pointer flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm transition-colors hover:border-primary/30 " do %>
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary /40 ">
                <span class="material-symbols-outlined text-2xl">payments</span>
              </div>
              <% if @current_payroll %>
                <span class="rounded-full bg-muted px-2 py-0.5 text-xs font-bold text-muted-foreground "><%= @current_payroll.status.humanize %></span>
              <% else %>
                <span class="material-symbols-outlined text-lg text-muted-foreground/60">arrow_forward</span>
              <% end %>
            </div>
            <div class="mt-3">
              <p class="text-sm font-bold text-foreground">Payroll</p>
              <p class="mt-0.5 text-xs text-muted-foreground">Status &amp; hours</p>
            </div>
          <% end %>

          <%= link_to new_mobile_company_attendance_request_path(@company), class: "group flex cursor-pointer flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm transition-colors hover:border-primary/30 " do %>
            <div class="flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary /40 ">
                <span class="material-symbols-outlined text-2xl">assignment_late</span>
              </div>
              <% if @pending_requests_count.positive? %>
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-danger text-xs font-bold text-danger-foreground"><%= @pending_requests_count %></span>
              <% else %>
                <span class="material-symbols-outlined text-lg text-muted-foreground/60">arrow_forward</span>
              <% end %>
            </div>
            <div class="mt-3">
              <p class="text-sm font-bold text-foreground">Requests</p>
              <p class="mt-0.5 text-xs text-muted-foreground">File an attendance request</p>
            </div>
          <% end %>
        </div>
      </section>

      <% if @announcement %>
        <section class="flex items-start gap-3 rounded-xl border border-primary/20 bg-primary/10 p-4 ">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-card text-primary shadow-sm ">
            <span class="material-symbols-outlined text-2xl">campaign</span>
          </span>
          <div class="min-w-0">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">Company Notice</span>
            <p class="mt-0.5 text-sm font-semibold text-foreground"><%= @announcement.name %></p>
            <p class="text-xs text-muted-foreground"><%= @announcement.description %></p>
          </div>
        </section>
      <% end %>

      <section class="rounded-xl border border-line bg-card p-4 shadow-sm ">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-foreground">Today's Activity</h2>
          <span class="text-xs font-medium text-muted-foreground"><%= @today_logs.size %> events</span>
        </div>
        <div class="mt-3 flex flex-col gap-3">
          <% if @today_logs.any? %>
            <% @today_logs.each do |log| %>
              <div class="flex items-start gap-2">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full <%= log.log_type_check_in? ? "bg-success/10 text-success " : "bg-muted text-muted-foreground " %>">
                  <span class="material-symbols-outlined text-lg"><%= log.log_type_check_in? ? "login" : "logout" %></span>
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-2">
                    <p class="truncate text-sm font-semibold text-foreground"><%= log.log_type_check_in? ? "Clock In Recorded" : "Clock Out Recorded" %></p>
                    <span class="shrink-0 text-xs text-muted-foreground"><%= mobile_time(log.logged_at, utc_offset: @company_utc_offset) %></span>
                  </div>
                  <p class="truncate text-xs text-muted-foreground"><%= log.branch&.name || @employee.branch&.name || @company.name %></p>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-muted-foreground">No activity yet.</p>
          <% end %>
        </div>
      </section>
    </div>
  <% else %>
    <div class="flex flex-col items-center gap-2 rounded-xl border border-line bg-card p-6 text-center shadow-sm ">
      <span class="material-symbols-outlined text-4xl text-muted-foreground">badge</span>
      <h2 class="text-lg font-bold text-foreground"><%= mobile_greeting(current_user.name) %></h2>
      <p class="text-sm text-muted-foreground">No employee profile linked. Ask a company admin to link your account to an employee record.</p>
      <div class="mt-2 w-full">
        <%= button_to mobile_sign_out_path, method: :delete, class: "flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-muted text-sm font-semibold text-foreground transition-colors hover:bg-muted " do %>
          Sign Out
        <% end %>
      </div>
    </div>
  <% end %>
</main>
