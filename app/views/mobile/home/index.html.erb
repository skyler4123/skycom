<div class="flex min-h-screen flex-col items-center justify-center px-6">
  <div class="w-full max-w-sm text-center">

    <% if notice %>
      <p class="text-green-600 text-sm mb-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="text-red-600 text-sm mb-4"><%= alert %></p>
    <% end %>

    <h1 class="text-2xl font-bold mb-2">Welcome, <%= current_user.name %></h1>
    <p class="text-gray-500 mb-8">You are signed in</p>

    <%= link_to "Employee Info", mobile_employee_path,
          class: "block w-full rounded-lg bg-green-600 px-4 py-3 text-base font-semibold text-white hover:bg-green-700 cursor-pointer mb-4" %>

    <%= button_to "Check In", mobile_attendances_path, method: :post,
          class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-base font-semibold text-white hover:bg-blue-700 cursor-pointer mb-4" %>

    <%= button_to "Sign Out", mobile_sign_out_path, method: :delete,
          class: "w-full rounded-lg bg-red-600 px-4 py-3 text-base font-semibold text-white hover:bg-red-700 cursor-pointer" %>
  </div>
</div>
