<% next_disabled = local_assigns[:next_disabled] %>
<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <%= link_to prev_path, class: "flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-400", aria: { label: "Previous month" } do %>
    <span class="material-symbols-outlined text-xl">chevron_left</span>
  <% end %>

  <span class="flex min-w-0 items-center gap-2 px-2 text-sm font-semibold text-slate-900 dark:text-white">
    <span class="material-symbols-outlined text-lg text-blue-600 dark:text-blue-400">calendar_month</span>
    <span class="truncate"><%= label %></span>
  </span>

  <% if next_disabled %>
    <span class="flex h-10 w-10 shrink-0 cursor-not-allowed items-center justify-center rounded-lg text-slate-300 dark:text-slate-600" aria-disabled="true" aria-label="Next month">
      <span class="material-symbols-outlined text-xl">chevron_right</span>
    </span>
  <% else %>
    <%= link_to next_path, class: "flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-400", aria: { label: "Next month" } do %>
      <span class="material-symbols-outlined text-xl">chevron_right</span>
    <% end %>
  <% end %>
</div>
