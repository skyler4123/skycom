<% next_disabled = local_assigns[:next_disabled] %>
<div class="flex items-center justify-between rounded-xl border border-line bg-card p-2 shadow-sm ">
  <%= link_to prev_path, class: "flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-primary ", aria: { label: "Previous month" } do %>
    <span class="material-symbols-outlined text-xl">chevron_left</span>
  <% end %>

  <span class="flex min-w-0 items-center gap-2 px-2 text-sm font-semibold text-foreground">
    <span class="material-symbols-outlined text-lg text-primary">calendar_month</span>
    <span class="truncate"><%= label %></span>
  </span>

  <% if next_disabled %>
    <span class="flex h-10 w-10 shrink-0 cursor-not-allowed items-center justify-center rounded-lg text-muted-foreground/60" aria-disabled="true" aria-label="Next month">
      <span class="material-symbols-outlined text-xl">chevron_right</span>
    </span>
  <% else %>
    <%= link_to next_path, class: "flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-primary ", aria: { label: "Next month" } do %>
      <span class="material-symbols-outlined text-xl">chevron_right</span>
    <% end %>
  <% end %>
</div>
