<% notice_message = flash[:notice] %>
<% alert_message = flash[:alert] %>
<% if notice_message.present? || alert_message.present? %>
  <div class="fixed inset-x-4 top-[calc(0.5rem+env(safe-area-inset-top))] z-50 space-y-2">
    <% if notice_message.present? %>
      <div data-controller="mobile--flash" class="flex items-start gap-2 rounded-xl border border-green-200 bg-green-50 p-3 shadow-lg dark:border-green-800 dark:bg-green-900/40">
        <span class="material-symbols-outlined text-xl text-green-700 dark:text-green-400">check_circle</span>
        <p class="min-w-0 flex-1 text-sm font-medium text-green-800 dark:text-green-300"><%= notice_message %></p>
        <button type="button" data-action="click->mobile--flash#dismiss" class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-green-700 transition-colors hover:bg-green-100 dark:text-green-400 dark:hover:bg-green-900/60" aria-label="Dismiss notification">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    <% end %>
    <% if alert_message.present? %>
      <div data-controller="mobile--flash" class="flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 p-3 shadow-lg dark:border-red-800 dark:bg-red-900/40">
        <span class="material-symbols-outlined text-xl text-red-700 dark:text-red-400">error</span>
        <p class="min-w-0 flex-1 text-sm font-medium text-red-800 dark:text-red-300"><%= alert_message %></p>
        <button type="button" data-action="click->mobile--flash#dismiss" class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-red-700 transition-colors hover:bg-red-100 dark:text-red-400 dark:hover:bg-red-900/60" aria-label="Dismiss notification">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
