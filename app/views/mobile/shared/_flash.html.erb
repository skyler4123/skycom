<% notice_message = flash[:notice] %>
<% alert_message = flash[:alert] %>
<% if notice_message.present? || alert_message.present? %>
  <div class="fixed inset-x-4 top-[calc(0.5rem+env(safe-area-inset-top))] z-50 space-y-2">
    <% if notice_message.present? %>
      <div data-controller="mobile--flash" class="flex items-start gap-2 rounded-xl border border-success/20 bg-success/10 p-3 shadow-lg ">
        <span class="material-symbols-outlined text-xl text-success ">check_circle</span>
        <p class="min-w-0 flex-1 text-sm font-medium text-success "><%= notice_message %></p>
        <button type="button" data-action="click->mobile--flash#dismiss" class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-success transition-colors hover:bg-success/10 " aria-label="Dismiss notification">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    <% end %>
    <% if alert_message.present? %>
      <div data-controller="mobile--flash" class="flex items-start gap-2 rounded-xl border border-danger/20 bg-danger/10 p-3 shadow-lg ">
        <span class="material-symbols-outlined text-xl text-danger ">error</span>
        <p class="min-w-0 flex-1 text-sm font-medium text-danger "><%= alert_message %></p>
        <button type="button" data-action="click->mobile--flash#dismiss" class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-danger transition-colors hover:bg-danger/10 " aria-label="Dismiss notification">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
