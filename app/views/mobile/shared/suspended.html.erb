<% content_for :title, "Company suspended" %>

<main class="mx-auto w-full max-w-lg md:max-w-2xl lg:max-w-4xl xl:max-w-5xl px-4 pb-8 pt-4">
  <section class="rounded-xl border border-warning/30 bg-warning/10 p-5 shadow-sm">
    <div class="flex items-start gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-warning/15 text-warning">
        <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
      </span>
      <div class="min-w-0">
        <h1 class="text-lg font-bold text-foreground">Company suspended</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          <%= @company.name %> has no usable credit. Please top up from the web app to continue using Skycom on mobile.
        </p>
      </div>
    </div>
  </section>
</main>
