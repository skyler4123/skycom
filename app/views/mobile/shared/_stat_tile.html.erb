<% icon = local_assigns[:icon] %>
<% hint = local_assigns[:hint] %>
<% hint_class = local_assigns[:hint_class] || "text-slate-500 dark:text-slate-400" %>
<div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-medium text-slate-500 dark:text-slate-400"><%= label %></span>
    <span class="flex items-center gap-1">
      <% if local_assigns[:sample] %>
        <%= mobile_sample_badge %>
      <% end %>
      <% if icon.present? %>
        <span class="material-symbols-outlined text-xl text-blue-600 dark:text-blue-400"><%= icon %></span>
      <% end %>
    </span>
  </div>
  <div class="mt-2">
    <p class="text-lg font-bold leading-tight text-slate-900 dark:text-white"><%= value %></p>
    <% if hint.present? %>
      <p class="mt-0.5 text-xs <%= hint_class %>"><%= hint %></p>
    <% end %>
  </div>
</div>
