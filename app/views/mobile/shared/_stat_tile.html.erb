<% icon = local_assigns[:icon] %>
<% hint = local_assigns[:hint] %>
<% hint_class = local_assigns[:hint_class] || "text-muted-foreground" %>
<div class="flex flex-col justify-between rounded-xl border border-line bg-card p-4 shadow-sm ">
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-medium text-muted-foreground"><%= label %></span>
    <span class="flex items-center gap-1">
      <% if icon.present? %>
        <span class="material-symbols-outlined text-xl text-primary"><%= icon %></span>
      <% end %>
    </span>
  </div>
  <div class="mt-2">
    <p class="text-lg font-bold leading-tight text-foreground"><%= value %></p>
    <% if hint.present? %>
      <p class="mt-0.5 text-xs <%= hint_class %>"><%= hint %></p>
    <% end %>
  </div>
</div>
