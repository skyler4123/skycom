<% back_path = local_assigns[:back_path] %>
<% avatar_name = local_assigns[:avatar_name] %>
<% avatar_path = local_assigns[:avatar_path] %>
<% replace_navigation = local_assigns[:replace_navigation] %>
<header class="sticky top-0 z-40 border-b border-line bg-card/90 pt-[env(safe-area-inset-top)] backdrop-blur-xl ">
  <div class="flex h-16 items-center justify-between gap-2 px-4">
    <% if back_path.present? %>
      <% back_options = { class: "flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted ", aria: { label: "Go back" } } %>
      <% back_options[:data] = { turbo_action: "replace" } if replace_navigation %>
      <div class="flex min-w-0 items-center gap-1">
        <%= link_to back_path, back_options do %>
          <span class="material-symbols-outlined text-2xl">arrow_back</span>
        <% end %>
        <h1 class="truncate text-base font-semibold leading-tight text-foreground"><%= title %></h1>
      </div>
    <% else %>
      <div class="flex min-w-0 items-center gap-2">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm ">
          <span class="material-symbols-outlined text-xl">hub</span>
        </div>
        <div class="flex min-w-0 flex-col">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary">Skycom ERP</span>
          <h1 class="truncate text-base font-semibold leading-tight text-foreground"><%= title %></h1>
        </div>
      </div>
    <% end %>

    <div class="flex shrink-0 items-center gap-1">
      <button type="button" data-controller="mobile--theme" data-action="click->mobile--theme#toggle" class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground " aria-label="Toggle dark mode">
        <span class="dark:hidden"><span class="material-symbols-outlined text-2xl">dark_mode</span></span>
        <span class="hidden dark:block"><span class="material-symbols-outlined text-2xl">light_mode</span></span>
      </button>
      <% if avatar_name.present? %>
        <% avatar_options = { class: "ml-1 flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full bg-primary text-xs font-bold text-primary-foreground" } %>
        <% avatar_options[:data] = { turbo_action: "replace" } if replace_navigation %>
        <%= link_to(avatar_path || mobile_sign_in_path, avatar_options) do %>
          <%= mobile_initials(avatar_name) %>
        <% end %>
      <% end %>
    </div>
  </div>
</header>
