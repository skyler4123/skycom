<div class="flex min-h-screen flex-col px-6 py-8">
  <div class="w-full max-w-sm mx-auto">

    <h1 class="text-2xl font-bold mb-6">Payroll</h1>

    <% if @payroll %>
      <div class="space-y-3 text-sm mb-6">
        <div class="flex justify-between">
          <span class="text-gray-500">Employee</span>
          <span class="font-semibold"><%= @employee.name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Month</span>
          <span class="font-semibold"><%= @payroll.month.strftime("%B %Y") %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Status</span>
          <span class="font-semibold"><%= @payroll.status.humanize %></span>
        </div>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm mb-6">No payroll data for this month.</p>
    <% end %>

    <%= form_with url: mobile_payroll_path, method: :get, local: true do %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Month</label>
        <%= select_tag :month,
              options_for_select(@months.map { |m| [m.month.strftime("%B %Y"), m.month.strftime("%Y-%m")] }, @month.strftime("%Y-%m")),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" %>
      </div>
      <%= submit_tag "Change Month", class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-base font-semibold text-white hover:bg-blue-700 cursor-pointer mb-4" %>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to Home", mobile_home_path,
            class: "block text-center w-full rounded-lg bg-gray-600 px-4 py-3 text-base font-semibold text-white hover:bg-gray-700 cursor-pointer" %>
    </div>

  </div>
</div>