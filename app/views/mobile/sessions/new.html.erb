<div class="flex min-h-screen flex-col items-center justify-center px-6">
  <div class="w-full max-w-sm">
    <h1 class="text-2xl font-bold text-center mb-8">Sign in to Skycom</h1>

    <% if notice %>
      <p class="text-green-600 text-sm text-center mb-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="text-red-600 text-sm text-center mb-4"><%= alert %></p>
    <% end %>

    <%= form_tag mobile_sign_in_path, class: "space-y-4" do %>
      <div>
        <%= email_field_tag :email, nil, placeholder: "Email", required: true,
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= password_field_tag :password, nil, placeholder: "Password", required: true,
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <%= submit_tag "Sign In", class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-base font-semibold text-white hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </div>
</div>
