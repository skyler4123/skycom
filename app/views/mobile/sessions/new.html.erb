<% content_for :title, "Sign in · Skycom" %>

<main class="relative flex min-h-dvh flex-col overflow-hidden bg-slate-50 px-4 pb-8 pt-[calc(2rem+env(safe-area-inset-top))] dark:bg-slate-950">
  <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-blue-100/60 blur-3xl dark:bg-blue-900/20"></div>
  <div class="pointer-events-none absolute -left-28 top-1/3 h-80 w-80 rounded-full bg-slate-200/60 blur-3xl dark:bg-slate-800/40"></div>

  <div class="relative z-10 flex w-full flex-1 flex-col justify-center">
    <div class="mb-6 flex flex-col items-center text-center">
      <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-tr from-blue-700 to-blue-500 text-white shadow-lg">
        <span class="material-symbols-outlined text-4xl">hub</span>
      </div>
      <div class="mb-1 flex items-center gap-2">
        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Skycom</span>
        <span class="rounded-md bg-blue-100 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">ERP</span>
      </div>
      <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Welcome back</h1>
      <p class="mt-1 max-w-xs text-sm text-slate-500 dark:text-slate-400">Sign in to access your workspace</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg dark:border-slate-800 dark:bg-slate-900">
      <% if flash[:alert].present? %>
        <div class="mb-4 flex items-start gap-2 rounded-lg border border-red-200 bg-red-50 p-3 dark:border-red-800 dark:bg-red-900/30">
          <span class="material-symbols-outlined text-lg text-red-700 dark:text-red-400">error</span>
          <p class="text-sm font-medium text-red-800 dark:text-red-300"><%= flash[:alert] %></p>
        </div>
      <% end %>

      <%= form_tag mobile_sign_in_path, class: "flex flex-col gap-4" do %>
        <div class="flex flex-col gap-1.5">
          <%= label_tag :email, "Email", class: "text-xs font-semibold text-slate-700 dark:text-slate-300" %>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined pointer-events-none absolute left-3 text-xl text-slate-400 dark:text-slate-500">mail</span>
            <%= email_field_tag :email, @email, placeholder: "name@company.com", required: true, autocomplete: "email", class: "h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-4 text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 focus:bg-white dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:bg-slate-900" %>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <%= label_tag :password, "Password", class: "text-xs font-semibold text-slate-700 dark:text-slate-300" %>
          <div class="relative flex items-center" data-controller="mobile--password-visibility">
            <span class="material-symbols-outlined pointer-events-none absolute left-3 text-xl text-slate-400 dark:text-slate-500">lock</span>
            <%= password_field_tag :password, nil, placeholder: "Enter your password", required: true, autocomplete: "current-password", id: "password", data: { mobile__password_visibility_target: "input" }, class: "h-12 w-full rounded-xl border border-slate-200 bg-slate-50 pl-11 pr-11 text-sm text-slate-900 outline-none transition-colors placeholder:text-slate-400 focus:border-blue-500 focus:bg-white dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder:text-slate-500 dark:focus:border-blue-400 dark:focus:bg-slate-900" %>
            <button type="button" aria-label="Show password" data-mobile--password-visibility-target="button" data-action="click->mobile--password-visibility#toggle" class="absolute right-2 flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-slate-400 transition-colors hover:text-slate-900 dark:text-slate-500 dark:hover:text-white">
              <span data-mobile--password-visibility-target="showIcon">
                <span class="material-symbols-outlined text-xl">visibility</span>
              </span>
              <span data-mobile--password-visibility-target="hideIcon" class="hidden">
                <span class="material-symbols-outlined text-xl">visibility_off</span>
              </span>
            </button>
          </div>
        </div>

        <button type="submit" class="mt-1 flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 text-base font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 active:scale-95 dark:bg-blue-500 dark:hover:bg-blue-600">
          Sign In
        </button>
      <% end %>
    </div>

    <p class="mt-8 text-center text-xs text-slate-400 dark:text-slate-500">Protected by Skycom</p>
  </div>
</main>
