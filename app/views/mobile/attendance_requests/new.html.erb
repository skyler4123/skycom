<div class="flex min-h-screen flex-col items-center px-6 py-8">
  <div class="w-full max-w-sm">
    <h1 class="text-2xl font-bold mb-6 text-center">New Attendance Request</h1>

    <% if alert %>
      <p class="text-red-600 text-sm mb-4"><%= alert %></p>
    <% end %>

    <%= form_with url: mobile_attendance_requests_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
        <%= f.date_field "attendance_request[attendance_date]", value: @attendance_request.attendance_date, required: true,
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
        <%= f.select "attendance_request[business_type]",
              options_for_select([ [ "Onsite Miss", "onsite_miss" ], [ "Remote Work", "remote_work" ], [ "Field Work", "field_work" ] ]),
              {}, class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Check In</label>
        <%= f.datetime_local_field "attendance_request[check_in]", required: true,
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Check Out</label>
        <%= f.datetime_local_field "attendance_request[check_out]",
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
        <%= f.text_area "attendance_request[reason]", rows: 3, required: true, placeholder: "Why could you not check in onsite?",
              class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-base" %>
      </div>
      <%= f.submit "Submit Request",
            class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-base font-semibold text-white hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <%= link_to "Back", mobile_home_path, class: "block text-center mt-4 text-sm text-gray-500 hover:text-gray-700 cursor-pointer" %>
  </div>
</div>
