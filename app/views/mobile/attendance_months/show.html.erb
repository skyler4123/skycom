<div class="flex min-h-screen flex-col px-6 py-8">
  <div class="w-full max-w-sm mx-auto">

    <h1 class="text-2xl font-bold mb-6">Attendance Month</h1>

    <% if @attendance_month %>
      <div class="space-y-3 text-sm mb-6">
        <div class="flex justify-between">
          <span class="text-gray-500">Employee</span>
          <span class="font-semibold"><%= @employee.name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Month</span>
          <span class="font-semibold"><%= @attendance_month.month.strftime("%B %Y") %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Total Worked</span>
          <span class="font-semibold"><%= @attendance_month.total_work_minutes %> min</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Days Present</span>
          <span class="font-semibold"><%= @attendance_month.total_present_days %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Days Absent</span>
          <span class="font-semibold"><%= @attendance_month.total_absent_days %></span>
        </div>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm mb-6">No attendance data for this month.</p>
    <% end %>

    <%= form_with url: mobile_attendance_month_path, method: :get, local: true do %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">Month</label>
        <%= select_tag :month,
              options_for_select(@months.map { |m| [m.month.strftime("%B %Y"), m.month.strftime("%Y-%m")] }, @month.strftime("%Y-%m")),
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" %>
      </div>
      <%= submit_tag "Change Month", class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-base font-semibold text-white hover:bg-blue-700 cursor-pointer mb-4" %>
    <% end %>

    <h2 class="text-lg font-bold mb-3">Daily Breakdown</h2>
    <% if @attendance_days.any? %>
      <div class="space-y-2 mb-6">
        <% @attendance_days.each do |day| %>
          <div class="flex justify-between text-sm border border-gray-200 rounded-lg px-3 py-2">
            <span><%= day.attendance_date.strftime("%d %b") %></span>
            <span><%= day.attendance_status&.humanize || "—" %></span>
            <span><%= (day.total_seconds_worked.to_i / 60) %>min</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm mb-6">No daily records for this month yet.</p>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to Home", mobile_home_path,
            class: "block text-center w-full rounded-lg bg-gray-600 px-4 py-3 text-base font-semibold text-white hover:bg-gray-700 cursor-pointer" %>
    </div>

  </div>
</div>